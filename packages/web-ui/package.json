{
  "name": "@lykomi/web-ui",
  "version": "0.54.0",
  "license": "MIT",
  "description": "React agent UI core for LYKOMI UI — chat, composer, AG-UI adapter for assistant-ui, tool cards, panels, sidebar, theme runtime, and UI stores.",
  "keywords": [
    "react",
    "ag-ui",
    "assistant-ui",
    "chat",
    "agent",
    "lykomi-ui",
    "agent-framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lykomi/ui.git",
    "directory": "packages/web-ui"
  },
  "homepage": "https://github.com/lykomi/ui/tree/main/packages/web-ui#readme",
  "bugs": "https://github.com/lykomi/ui/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js"
    },
    "./styles.css": "./dist/styles.css",
    "./workbench": {
      "types": "./dist/workbench.d.ts",
      "import": "./dist/workbench.js"
    },
    "./windows": {
      "types": "./dist/windows.d.ts",
      "import": "./dist/windows.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-dts-extensions.mjs dist && cp src/styles.css dist/styles.css",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ag-ui/client": "^0.0.52",
    "@ag-ui/core": "^0.0.52",
    "@assistant-ui/react": "^0.15.1",
    "@azure/msal-browser": "^5.0.0",
    "@azure/msal-react": "^5.0.0",
    "lucide-react": ">=0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@azure/msal-browser": {
      "optional": true
    },
    "@azure/msal-react": {
      "optional": true
    }
  },
  "dependencies": {
    "@lykomi/agent": "workspace:^",
    "@lykomi/web-primitives": "workspace:^",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dompurify": "^3.4.16",
    "mermaid": "^11.17.2",
    "modern-screenshot": "^4.7.0",
    "react-markdown": "^10.0.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.0",
    "tabbable": "^6.5.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@ag-ui/client": "^0.0.52",
    "@ag-ui/core": "^0.0.52",
    "@assistant-ui/react": "^0.15.1",
    "@azure/msal-browser": "^5.0.0",
    "@azure/msal-react": "^5.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^28.1.0",
    "lucide-react": ">=0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.4",
    "zustand": "^5.0.0"
  }
}
