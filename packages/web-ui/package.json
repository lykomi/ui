{
  "name": "@iloveagents/foundry-web-ui",
  "version": "0.3.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-dts-extensions.mjs dist && cp src/styles.css dist/styles.css",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "@assistant-ui/react": "^0.12.25",
    "@ag-ui/client": "^0.0.52",
    "@ag-ui/core": "^0.0.52",
    "zustand": "^5.0.0",
    "lucide-react": ">=0.400.0",
    "@azure/msal-browser": "^5.0.0",
    "@azure/msal-react": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@azure/msal-browser": {
      "optional": true
    },
    "@azure/msal-react": {
      "optional": true
    }
  },
  "dependencies": {
    "@iloveagents/foundry-agent": "workspace:^",
    "@iloveagents/foundry-web-primitives": "workspace:^",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
