{
  "name": "@iloveagents/foundry-web-shell",
  "version": "0.32.1",
  "license": "MIT",
  "description": "Browser bootstrap and layout shell for Foundry UI — bootstrapShell({ modules, pages, theme, authProvider }) mounts the SPA around foundry-web-ui. Module-agnostic.",
  "keywords": [
    "react",
    "ag-ui",
    "shell",
    "bootstrap",
    "foundry-ui",
    "agent",
    "spa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iLoveAgents/foundry-ui.git",
    "directory": "packages/web-shell"
  },
  "homepage": "https://github.com/iLoveAgents/foundry-ui/tree/main/packages/web-shell#readme",
  "bugs": "https://github.com/iLoveAgents/foundry-ui/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-dts-extensions.mjs dist",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "@assistant-ui/react": "^0.15.1",
    "lucide-react": ">=0.400.0",
    "zustand": "^5.0.0"
  },
  "dependencies": {
    "@iloveagents/foundry-agent": "workspace:^",
    "@iloveagents/foundry-web-primitives": "workspace:^",
    "@iloveagents/foundry-web-ui": "workspace:^"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.15.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^28.1.0",
    "lucide-react": ">=0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.4",
    "zustand": "^5.0.0"
  }
}
