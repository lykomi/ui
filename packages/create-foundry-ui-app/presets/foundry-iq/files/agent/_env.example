# Copy to agent/.env and fill these values for Microsoft Agent Framework.
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project
FOUNDRY_MODEL=gpt-5.4

# Foundry IQ MCP endpoint inputs.
# The app derives:
# ${AZURE_AI_SEARCH_ENDPOINT}/knowledgebases/${FOUNDRY_IQ_KNOWLEDGE_BASE}/mcp?api-version=2026-05-01-preview
# and uses the documented retrieve action with includeActivity=true for real activity diagnostics.
AZURE_AI_SEARCH_ENDPOINT=https://your-search.search.windows.net
FOUNDRY_IQ_KNOWLEDGE_BASE=your-knowledge-base
# FOUNDRY_IQ_INCLUDE_ACTIVITY=true
# FOUNDRY_IQ_MAX_OUTPUT_DOCUMENTS=6

# Optional local-dev fallback for SharePoint-backed knowledge sources.
# Production should pass the signed-in user's bearer token per request instead.
# FOUNDRY_IQ_QUERY_SOURCE_AUTHORIZATION=Bearer <user-token>

# DefaultAzureCredential uses `az login` locally, service principal env vars in CI,
# and managed identity in Azure. Uncomment tenant/client values only when needed.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
