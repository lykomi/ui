# --- Chat model (required) -------------------------------------------------
# The agent itself runs on Azure AI Foundry, whichever database you point at.
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=<your-chat-model-deployment>

# --- Graph database (required) ---------------------------------------------
# Local, via `docker compose up -d` in the project root:
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=localdevpassword

# Neo4j Aura instead — same code, only the URI and credentials change:
# NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<the password shown when the instance was created>

# NEO4J_DATABASE=neo4j

# --- Guardrails (optional, shown with their defaults) ----------------------
# Caps on what one query may return. The graph tools stop pulling at these
# limits and tell the UI the result was truncated.
# NEO4J_MAX_NODES=300
# NEO4J_MAX_EDGES=600
# NEO4J_MAX_ROWS=200
# NEO4J_MAX_NEIGHBOURS=15
# NEO4J_QUERY_TIMEOUT_SECONDS=15

# Writes are OFF by default: with NEO4J_ALLOW_WRITES unset, the write tool is
# not registered at all, so the model cannot call it. Read the "Letting the
# agent write" section of the README before turning this on — there is no
# human-approval step in front of it.
# NEO4J_ALLOW_WRITES=false

# --- Semantic search (optional) --------------------------------------------
# Set both to register the graph_vector_search tool. The seed script will then
# also embed the demo data and create the index.
# FOUNDRY_MODELS_ENDPOINT=https://<your-project>.services.ai.azure.com/models
# FOUNDRY_EMBEDDING_MODEL=<your-embedding-model-deployment>
# NEO4J_VECTOR_INDEX=movie_embeddings

# Local dev with a service principal instead of `az login`:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
