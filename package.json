{
  "name": "lykomi-ui",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "Open-source agent UI starter — AG-UI protocol, Microsoft Agent Framework, Azure Foundry. Cross-runtime transport + React shell.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "test": "pnpm check:starter-skills && pnpm check:form-ux && pnpm check:sensitive && pnpm build && pnpm lint && pnpm typecheck && pnpm test:unit",
    "test:unit": "pnpm -r --if-present test:unit",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "prettier --check package.json README.md packages/*/package.json packages/*/README.md packages/create-lykomi-app/template/README.md",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "pack:check": "node scripts/check-packages.mjs",
    "check:sensitive": "node scripts/check-sensitive-terms.mjs",
    "smoke:starter": "node scripts/smoke-starter.mjs",
    "smoke:starter:browser": "node scripts/smoke-starter.mjs --browser",
    "smoke:neo4j": "node scripts/smoke-neo4j-preset.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm --filter @lykomi/agent build && pnpm --filter @lykomi/web-primitives build && pnpm --filter @lykomi/web-ui build && pnpm --filter @lykomi/web-graph build && pnpm --filter @lykomi/web-3d build && pnpm --filter @lykomi/web-shell build && pnpm --filter @lykomi/web-voice build && pnpm --filter create-lykomi-app build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && node scripts/sync-template-versions.mjs",
    "changeset:publish": "changeset publish",
    "sync:template-versions": "node scripts/sync-template-versions.mjs",
    "screenshot:starter": "node scripts/smoke-starter.mjs --screenshot docs/assets/starter.png",
    "sync:form-ux": "node scripts/sync-form-ux.mjs && pnpm sync:starter-skills",
    "check:form-ux": "node scripts/sync-form-ux.mjs --check",
    "sync:starter-skills": "node scripts/sync-starter-skills.mjs",
    "check:starter-skills": "node scripts/sync-starter-skills.mjs --check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "playwright": "^1.61.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.4"
  }
}
