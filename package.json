{
  "name": "foundry-ui",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "description": "Open-source agent UI starter — AG-UI protocol, Microsoft Agent Framework, Azure Foundry. Cross-runtime transport + React shell.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "test": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "test:unit": "pnpm -r --if-present test:unit",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "react-router": "^7.14.1",
      "@assistant-ui/react": "^0.12.25",
      "@ag-ui/client": "^0.0.52",
      "@ag-ui/core": "^0.0.52"
    }
  }
}
